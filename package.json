{
  "name": "poker-practice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/api/src/server.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/server.js && esbuild apps/api/src/assistant-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/assistant-worker.js",
    "start": "node dist/api/server.js",
    "db:setup": "tsx apps/api/src/setup.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write apps packages tests *.ts package.json tsconfig.json README.md",
    "solver:setup": "tsx scripts/setup-solver.ts",
    "ml:generate": "tsx scripts/ml-generate.ts",
    "ml:train": "python3 scripts/ml-train.py",
    "ml:benchmark": "tsx scripts/ml-benchmark.ts",
    "data:backup": "tsx scripts/data-backup.ts",
    "data:restore": "tsx scripts/data-restore.ts",
    "ml:mistake-test": "tsx scripts/ml-mistake-experiment.ts",
    "ml:compare-speed": "tsx scripts/ml-compare-speed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "pokersolver": "^2.1.4",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
